---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
  <div class="flex justify-center">
    <div class="max-sm:w-full sm:w-2xl">
      <slot />
    </div>
  </div>
</BaseLayout>
