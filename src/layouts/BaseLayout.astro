---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Nav/Header.astro";
import BaseHead from "@/layouts/BaseHead.astro";

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<html lang="en" class="flex justify-center">
  <head>
    <BaseHead pageTitle={pageTitle} />
  </head>
  <body
    class="overflow-x-hidden bg-[url(/src/assets/background.svg)] bg-repeat antialiased"
  >
    <div class="min-h-screen w-screen max-sm:px-10 sm:max-lg:px-16 lg:w-4xl">
      <Header />
      <main>
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
