---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Nav/Header.astro";
import BaseHead from "@/layouts/BaseHead.astro";

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en" class="flex justify-center">
  <head>
    <BaseHead pageTitle={pageTitle} />
  </head>
  <body class="w-5xl overflow-x-hidden antialiased">
    <main class="min-h-screen">
      <Header />
      <slot />
    </main>
    <Footer />
  </body>
</html>
