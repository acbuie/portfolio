---
import { getCollection } from "astro:content";

import { arrangePostCollection, getTags } from "@/utils/posts";
import voca from "voca";

import SubArchive from "@/layouts/SubArchive.astro";

export async function getStaticPaths() {
  const rawPosts = await getCollection("blogPosts");
  const tags = getTags(rawPosts);

  return tags.map((tag) => {
    const filteredPosts = rawPosts.filter((post) =>
      post.data.tags.includes(tag),
    );

    const postsArray = arrangePostCollection(filteredPosts);

    return {
      params: { tag },
      props: { postsArray: postsArray },
    };
  });
}

const { postsArray } = Astro.props;
const { tag } = Astro.params;

const pageTitle = `${voca.titleCase(tag)} | Aidan Buie`;
const group = "Tag";
---

<SubArchive
  pageTitle={pageTitle}
  group={group}
  heading={voca.titleCase(tag)}
  subheading="test"
  postsArray={postsArray}
/>
