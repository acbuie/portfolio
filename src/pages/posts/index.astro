---
import { getCollection } from "astro:content";

import { arrangePostCollection } from "@/utils/posts";

import PostsList from "@/components/PostsList.astro";
import Narrow from "@/layouts/Narrow.astro";

const rawPosts = await getCollection("blogPosts");
const postsArray = arrangePostCollection(rawPosts);

const pageTitle = "Musings | Aidan Buie";
---

<Narrow pageTitle={pageTitle}>
  <h1 class="font-gaya mb-4 text-4xl">Musings, chronologically</h1>

  <p class="text-xl">
    A chronological list of all my writing for this blog. Optionally, filter by
    category or tag!
  </p>

  <hr class="text-secondary my-4" />
  <span class="flex items-center justify-between">
    <a href="/posts/tags/">#Tags</a>
  </span>
  <hr class="text-secondary my-4" />

  <PostsList postsArray={postsArray} />
</Narrow>
