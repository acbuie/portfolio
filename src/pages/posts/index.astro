---
import { getCollection } from "astro:content";

import { arrangePostCollection } from "@/utils/posts";

import ArchiveNav from "@/components/Blog/ArchiveNav.astro";
import HeadingSub from "@/components/Blog/HeadingSub.astro";
import PostsList from "@/components/Blog/PostsList.astro";
import Narrow from "@/layouts/Narrow.astro";

const rawPosts = await getCollection("blogPosts");
const postsArray = arrangePostCollection(rawPosts);

const pageTitle = "Musings | Aidan Buie";
const heading = "My Latest Musings, Chronologically";
const subheading =
  "A chronological list of all my writing for this blog. Optionally, filter by category or view all tags in the archive.";
---

<Narrow pageTitle={pageTitle}>
  <HeadingSub heading={heading} subheading={subheading} />

  <ArchiveNav />

  <PostsList postsArray={postsArray} />
</Narrow>
