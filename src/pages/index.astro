---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const pageTitle = "Home | Aidan Buie";

type NavLink = {
  heading: string;
  items: {
    icon: string;
    title: string;
    href: string;
  }[];
}[];

const navLinks: NavLink = [
  {
    heading: "About",
    items: [
      { icon: "index/about", title: "About", href: "/about" },
      { icon: "index/timeline", title: "Currently", href: "/" },
      { icon: "index/wreath", title: "Colophon", href: "/colophon" },
    ],
  },
  {
    heading: "Musings",
    items: [
      { icon: "index/book", title: "Latest", href: "/posts" },
      { icon: "index/archive", title: "Archive", href: "/posts/archive" },
      { icon: "index/rss", title: "RSS Feed", href: "/" },
    ],
  },
  {
    heading: "Portfolio",
    items: [
      { icon: "index/cog", title: "Projects", href: "/portfolio/projects" },
      {
        icon: "index/map",
        title: "Cartography",
        href: "/portfolio/cartography",
      },
      {
        icon: "index/camera",
        title: "Photography",
        href: "/portfolio/photography",
      },
      { icon: "index/scroll", title: "Courses", href: "/portfolio/courses" },
    ],
  },
  {
    heading: "Links",
    items: [
      {
        icon: "index/links/github",
        title: "GitHub",
        href: "https://github.com/acbuie",
      },
      {
        icon: "index/links/linkedin",
        title: "LinkedIn",
        href: "https://www.linkedin.com/in/aidanbuie",
      },
      {
        icon: "index/links/cv",
        title: "Curriculum Vitae",
        href: "/",
      },
    ],
  },
];
---

<BaseLayout pageTitle={pageTitle}>
  <header class="mt-32">
    <h1
      class="font-heading mb-4 text-left text-lg tracking-widest italic sm:text-2xl"
    >
      AIDAN BUIE
    </h1>
    <p class="font-heading text-3xl font-black sm:text-6xl/20">
      Planetary scientist, educator, software developer, among many other
      things.
    </p>
  </header>

  <ul class="mt-16 sm:flex sm:justify-between">
    {
      navLinks.map((nav) => (
        <li>
          <h2 class="font-heading mb-4 text-2xl tracking-widest max-sm:mt-12 sm:text-3xl">
            {nav.heading}
          </h2>
          <ul class="flex flex-col gap-y-2">
            {nav.items.map((item) => (
              <li class="flex items-center gap-x-1">
                <Icon name={item.icon} class="size-5" />
                <a
                  class="text-lg"
                  target={
                    item.title === "GitHub" || item.title === "LinkedIn"
                      ? "_blank"
                      : null
                  }
                  rel={
                    item.title === "GitHub" || item.title === "LinkedIn"
                      ? "nofollow noopener noreferrer"
                      : null
                  }
                  href={item.href}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</BaseLayout>
