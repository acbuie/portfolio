---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const pageTitle = "Aidan Buie";

type NavLink = {
  heading: string;
  items: {
    icon: string;
    title: string;
    href: string;
  }[];
}[];

const navLinks: NavLink = [
  {
    heading: "About",
    items: [
      { icon: "construction", title: "About", href: "/about" },
      { icon: "construction", title: "Currently", href: "/" },
      { icon: "construction", title: "Colophon", href: "/" },
    ],
  },
  {
    heading: "Musings",
    items: [
      { icon: "construction", title: "Chronological", href: "/blog" },
      { icon: "construction", title: "Categories", href: "/" },
      { icon: "construction", title: "Tags", href: "/tags" },
    ],
  },
  {
    heading: "Portfolio",
    items: [
      { icon: "construction", title: "Projects", href: "/portfolio/projects" },
      {
        icon: "construction",
        title: "Cartography",
        href: "/portfolio/cartography",
      },
      {
        icon: "construction",
        title: "Photography",
        href: "/portfolio/photography",
      },
      { icon: "construction", title: "Courses", href: "/portfolio/courses" },
    ],
  },
  {
    heading: "Links",
    items: [
      {
        icon: "logo/github",
        title: "GitHub",
        href: "https://github.com/acbuie",
      },
      {
        icon: "logo/linkedin",
        title: "LinkedIn",
        href: "https://www.linkedin.com/in/aidanbuie",
      },
      {
        icon: "logo/cv",
        title: "Curriculum Vitae",
        href: "/",
      },
    ],
  },
];
---

<BaseLayout pageTitle={pageTitle}>
  <header class="mt-32">
    <h1 class="font-gaya mb-4 text-left text-2xl tracking-widest">
      AIDAN BUIE
    </h1>
    <p class="font-gaya text-6xl/20 font-black">
      Planetary scientist, educator, software developer, among many other
      things.
    </p>

    <ul class="mt-16 flex justify-between">
      {
        navLinks.map((nav) => (
          <li>
            <h2 class="font-gaya mb-4 text-3xl tracking-widest">
              {nav.heading}
            </h2>
            <ul class="flex flex-col gap-y-2">
              {nav.items.map((item) => (
                <li class="flex items-center gap-x-1">
                  <Icon name={item.icon} class="size-5" />
                  <a
                    class="text-lg"
                    target={
                      item.title === "GitHub" || item.title === "LinkedIn"
                        ? "_blank"
                        : null
                    }
                    rel={
                      item.title === "GitHub" || item.title === "LinkedIn"
                        ? "nofollow norefferer"
                        : null
                    }
                    href={item.href}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </header>
</BaseLayout>
